.page {
  min-height: 100vh;
  padding: 0 0 calc(188rpx + env(safe-area-inset-bottom));
  color: #111111;
  background: #f5f6fb;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  min-height: 92rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf0f5;
}

.topbar-inner {
  position: absolute;
  left: 34rpx;
  display: block;
  min-height: 56rpx;
}

.back-button {
  position: absolute;
  top: 50%;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 44rpx;
  height: 56rpx;
  margin: 0;
  color: #2d2f33;
  font-size: 54rpx;
  line-height: 56rpx;
  background: transparent;
  transform: translateY(-50%);
}

.agent-avatar {
  flex: 0 0 auto;
  overflow: hidden;
  background: #0b1f18;
  border-radius: 50%;
}

.agent-avatar-top {
  position: absolute;
  top: 50%;
  left: 58rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  transform: translateY(-50%);
}

.agent-avatar-message {
  width: 82rpx;
  height: 82rpx;
  margin-right: 22rpx;
}

.top-title {
  position: absolute;
  top: 50%;
  right: 0;
  left: 134rpx;
  min-width: 0;
  overflow: hidden;
  color: #252c3a;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 56rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateY(-50%);
}

.wechat-pill {
  display: none;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 56rpx;
  margin-left: 8rpx;
  color: #161616;
  font-size: 28rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid #e8ebf0;
  border-radius: 30rpx;
}

.pill-divider {
  width: 1rpx;
  height: 30rpx;
  margin: 0 14rpx;
  background: #edf0f5;
}

.conversation {
  height: calc(100vh - 280rpx - env(safe-area-inset-bottom));
  padding: 54rpx 34rpx 180rpx;
  box-sizing: border-box;
}

.assistant-row,
.message-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
}

.welcome-bubble {
  flex: 1;
  min-width: 0;
  padding: 28rpx 28rpx 32rpx;
  background: #eeeeee;
  border-radius: 18rpx;
}

.section-block + .section-block {
  margin-top: 20rpx;
}

.section-title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.section-text {
  margin-top: 8rpx;
  color: #111111;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 44rpx;
  white-space: pre-wrap;
}

.chat {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 32rpx;
  margin-top: 34rpx;
}

.agent-tools {
  display: flex;
  gap: 12rpx;
  padding-left: 104rpx;
  margin-top: 22rpx;
  overflow: hidden;
}

.tool-button {
  flex: 0 0 auto;
  height: 54rpx;
  padding: 0 18rpx;
  margin: 0;
  color: #3b4350;
  font-size: 24rpx;
  line-height: 54rpx;
  background: #ffffff;
  border: 1rpx solid #e4e8ef;
  border-radius: 28rpx;
}

.tool-button-active {
  color: #8a5b05;
  background: #fff3d2;
  border-color: #f5c76a;
}

.tool-button::after,
.quick-chip::after,
.message-copy::after,
.retry-button::after {
  border: 0;
}

.quick-block {
  padding-left: 104rpx;
  margin-top: 18rpx;
}

.quick-title {
  color: #6c7480;
  font-size: 23rpx;
  line-height: 34rpx;
}

.quick-scroll {
  width: 100%;
  margin-top: 10rpx;
  white-space: nowrap;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  margin: 0 12rpx 0 0;
  color: #3d4654;
  font-size: 25rpx;
  line-height: 58rpx;
  background: #ffffff;
  border: 1rpx solid #e5e9f0;
  border-radius: 30rpx;
}

.quick-chip-active {
  color: #1677ff;
  background: #eef6ff;
  border-color: #a8ccff;
}

.message-row-user {
  justify-content: flex-end;
}

.message-row-assistant {
  justify-content: flex-start;
}

.message {
  max-width: 74%;
  padding: 22rpx 26rpx;
  white-space: pre-wrap;
  border-radius: 18rpx;
}

.message text {
  font-size: 29rpx;
  line-height: 44rpx;
}

.message-attachments {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.message-image {
  width: 260rpx;
  height: 180rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.message-file {
  display: flex;
  align-items: center;
  max-width: 300rpx;
  height: 58rpx;
  padding: 0 14rpx;
  color: inherit;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.message-file-icon {
  flex: 0 0 auto;
  margin-right: 10rpx;
  font-size: 24rpx !important;
  line-height: 58rpx !important;
}

.message-file-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx !important;
  line-height: 58rpx !important;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-user {
  color: #ffffff;
  background: #1677ff;
}

.message-assistant {
  color: #111111;
  background: #eeeeee;
}

.message-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 42rpx;
  padding: 0;
  margin: 16rpx 0 0 auto;
  color: #6c7480;
  font-size: 22rpx;
  line-height: 42rpx;
  background: #ffffff;
  border-radius: 22rpx;
}

.typing-message {
  color: #555555;
}

.retry-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  margin-left: 104rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
}

.retry-text {
  flex: 1;
  min-width: 0;
  color: #9a3412;
  font-size: 24rpx;
  line-height: 36rpx;
}

.retry-button {
  flex: 0 0 auto;
  height: 50rpx;
  padding: 0 22rpx;
  margin: 0;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 50rpx;
  background: #f97316;
  border-radius: 26rpx;
}

.bottom-anchor {
  width: 100%;
  height: 2rpx;
}

.composer-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  padding: 20rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 22rpx 22rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(28, 35, 48, 0.06);
}

.composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 76rpx 76rpx;
  gap: 16rpx;
  align-items: center;
  width: 100%;
}

.upload-panel {
  position: absolute;
  right: 112rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  z-index: 35;
  width: 250rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e8ebf0;
  border-radius: 14rpx;
  box-shadow: 0 16rpx 42rpx rgba(17, 24, 39, 0.16);
}

.upload-action {
  display: flex;
  align-items: center;
  width: 100%;
  height: 86rpx;
  padding: 0 24rpx;
  margin: 0;
  color: #2d333d;
  font-size: 28rpx;
  line-height: 86rpx;
  text-align: left;
  background: #ffffff;
  border-radius: 0;
}

.upload-action + .upload-action {
  border-top: 1rpx solid #eef1f5;
}

.upload-action::after,
.attachment-remove::after,
.attachment-retry::after {
  border: 0;
}

.upload-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  margin-right: 18rpx;
  color: #5a606b;
  font-size: 31rpx;
  line-height: 40rpx;
}

.attachment-strip {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.attachment-chip {
  display: flex;
  align-items: center;
  max-width: 100%;
  height: 58rpx;
  padding: 0 8rpx 0 18rpx;
  color: #333a45;
  background: #f3f5f8;
  border: 1rpx solid #e6e9ef;
  border-radius: 12rpx;
}

.attachment-uploading {
  color: #1d4ed8;
  background: #eff6ff;
  border-color: #bfdbfe;
}

.attachment-failed {
  color: #b42318;
  background: #fff1f2;
  border-color: #fecdd3;
}

.attachment-uploaded {
  color: #17643a;
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.attachment-icon {
  flex: 0 0 auto;
  margin-right: 10rpx;
  color: #5f6673;
  font-size: 26rpx;
}

.attachment-name {
  max-width: 330rpx;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 58rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-status {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: inherit;
  font-size: 22rpx;
  line-height: 58rpx;
  opacity: 0.78;
}

.attachment-retry {
  flex: 0 0 auto;
  height: 40rpx;
  padding: 0 12rpx;
  margin: 0 0 0 8rpx;
  color: #b42318;
  font-size: 22rpx;
  line-height: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.attachment-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  margin: 0 0 0 8rpx;
  color: #7d8490;
  font-size: 30rpx;
  line-height: 44rpx;
  background: transparent;
}

.composer input {
  width: 100%;
  min-width: 0;
  height: 82rpx;
  padding: 0 24rpx;
  color: #111111;
  font-size: 30rpx;
  background: #ffffff;
  border: 1rpx solid #eff2f6;
  border-radius: 14rpx;
}

.placeholder {
  color: #8f939b;
}

.add-button,
.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  margin: 0;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 76rpx;
  border-radius: 50%;
}

.add-button {
  color: #ffffff;
  background: #1677ff;
}

.add-button-active {
  transform: rotate(45deg);
}

.send-button {
  color: #646a73;
  background: #d7dbe2;
}

.send-button text {
  transform: translateY(-2rpx);
}

.ai-note {
  margin-top: 14rpx;
  color: #aeb4c0;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  background: rgba(15, 23, 42, 0.42);
  box-sizing: border-box;
}

.privacy-panel {
  width: 100%;
  max-width: 620rpx;
  padding: 34rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 60rpx rgba(15, 23, 42, 0.18);
}

.privacy-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.privacy-desc {
  margin-top: 18rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 40rpx;
}

.privacy-link {
  margin-top: 18rpx;
  color: #1677ff;
  font-size: 26rpx;
  line-height: 40rpx;
}

.privacy-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.privacy-secondary,
.privacy-primary {
  height: 78rpx;
  padding: 0;
  margin: 0;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 78rpx;
  border-radius: 10rpx;
}

.privacy-secondary {
  color: #334155;
  background: #f1f5f9;
}

.privacy-primary {
  color: #ffffff;
  background: #1677ff;
}

.privacy-secondary::after,
.privacy-primary::after {
  border: 0;
}
