page {
  min-height: 100vh;
  color: #111827;
  background: #f5f6fb;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  min-width: 0;
  color: inherit;
  font: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: normal;
  overflow: visible;
}

button::after {
  display: none;
  border: 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
